---
import type { CollectionEntry } from "astro:content";
import Container from "@components/Container.astro";
import OgImage from "@components/OgImage.astro";
import ContentInteractions from "@components/ContentInteractions.astro";
import Layout from "@layouts/Layout.astro";
import { getExcerpt, getTextStats } from "@lib/post-metrics";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  // 記事末尾に出す、日付順で隣り合う記事。
  newer?: CollectionEntry<"blog">;
  older?: CollectionEntry<"blog">;
  headings?: { depth: number; slug: string; text: string }[];
};
const { entry, newer, older, headings = [] } = Astro.props;
// 見出しが少ない記事では目次を出さない。
const MIN_TOC_HEADINGS = 3;
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const showToc = tocHeadings.length >= MIN_TOC_HEADINGS;
const neighbors = [
  { label: "← 新しい記事", post: newer, className: "post-nav-newer" },
  { label: "古い記事 →", post: older, className: "post-nav-older" },
];
const isBlog = entry.collection === "blog";
const readingMinutes = isBlog
  ? getTextStats(entry.body ?? "").readingMinutes
  : undefined;
const tags = isBlog ? (entry.data.tags ?? []) : [];
const links =
  entry.collection === "projects"
    ? [
        ["demo", entry.data.demoURL],
        ["repo", entry.data.repoURL],
      ]
    : [];
const published = new Intl.DateTimeFormat("ja-JP", {
  dateStyle: "long",
  timeZone: "Asia/Tokyo",
}).format(entry.data.date);
---

<Layout
  title={entry.data.title}
  description={entry.data.description ||
    getExcerpt(entry.body ?? "") ||
    undefined}
  image={entry.data.ogImage ??
    `/og-image/${entry.collection}/${entry.id}.png?v=20260614-og-background`}
  article={isBlog ? { publishedTime: entry.data.date, tags } : undefined}
>
  <!-- 読了位置。CSS のスクロール駆動アニメーションだけで動く (site.css)。 -->
  <div class="reading-progress" aria-hidden="true"></div>
  <Container>
    <article
      data-pagefind-body
      data-post-transition-url={`/${entry.collection}/${entry.id}`}
    >
      <header
        class:list={[
          "reference-post-header",
          entry.data.ogImage && "has-image",
        ]}
      >
        <h1 data-pagefind-meta="title">
          <span class="post-transition-title">{entry.data.title}</span>
          {entry.data.draft && <span class="draft-label">(draft)</span>}
        </h1>
        <time
          class="reference-post-date"
          datetime={entry.data.date.toISOString()}>{published}</time
        >
        {
          readingMinutes && (
            <span class="reference-post-reading-time">
              ・約{readingMinutes}分で読めます
            </span>
          )
        }
        {
          tags.length > 0 && (
            <ul class="reference-tags">
              {tags.map((tag) => (
                <li>
                  <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
        {
          links.some(([, href]) => href) && (
            <nav class="reference-tag-grid">
              {links.map(
                ([label, href]) =>
                  href && (
                    <a
                      class="reference-tag-card"
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {label}
                    </a>
                  ),
              )}
            </nav>
          )
        }
      </header>
      {
        entry.data.ogImage && (
          <OgImage
            src={entry.data.ogImage}
            sizes="(min-width: 720px) 688px, calc(100vw - 2rem)"
            class="reference-post-image"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      {
        showToc && (
          <details class="post-toc" data-pagefind-ignore>
            <summary>目次</summary>
            <nav aria-label="目次">
              <ol>
                {tocHeadings.map((heading) => (
                  <li class:list={[heading.depth === 3 && "post-toc-sub"]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )
      }
      <div class="post-body"><slot /></div>
    </article>
    {
      (newer || older) && (
        <nav class="post-nav" aria-label="前後の記事" data-pagefind-ignore>
          {neighbors.map(
            ({ label, post, className }) =>
              post && (
                <a class={className} href={`/blog/${post.id}/`}>
                  <span class="post-nav-label">{label}</span>
                  <span class="post-nav-title">{post.data.title}</span>
                </a>
              ),
          )}
        </nav>
      )
    }
  </Container>
  <ContentInteractions />
</Layout>
