---
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description?: string;
  image?: string;
  article?: { publishedTime: Date; tags?: string[] };
};
const { title, description = SITE.DESCRIPTION, image, article } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      article={article && { ...article, headline: title }}
    />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
