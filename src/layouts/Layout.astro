---
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Container from "@components/Container.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description?: string;
  image?: string;
  page?: "default" | "home" | "article";
};

const { title, description, image, page = "default" } = Astro.props;
const resolvedDescription = description ?? SITE.DESCRIPTION;
---

<!doctype html>
<html
  lang="ja"
  class:list={["reference-page", page === "article" && "article-page"]}
>
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={resolvedDescription}
      image={image}
    />
  </head>
  <body>
    {
      page === "default" ? (
        <Header />
      ) : page === "home" ? (
        <>
          <div class="classic-only">
            <Header />
          </div>
          <header class="reference-home-header">
            <Container>
              <h1>{SITE.TITLE}</h1>
            </Container>
          </header>
        </>
      ) : (
        <header class="reference-article-header">
          <Container>
            <a class="classic-brand" href="/">
              {SITE.TITLE}
            </a>
            <a href="/">← 記事一覧へ戻る</a>
          </Container>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    {
      page === "article" ? (
        <footer class="reference-article-footer">
          <Container>
            <a href="/">← 記事一覧へ戻る</a>
          </Container>
        </footer>
      ) : (
        <Footer />
      )
    }
    <Pagefind />
    <button
      class="design-toggle"
      type="button"
      data-design-toggle
      aria-pressed="false"
    >
      以前のデザインに切替
    </button>
  </body>
</html>
