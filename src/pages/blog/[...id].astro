---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { isVisibleEntry } from "@lib/content-sort";
import EntryLayout from "@layouts/EntryLayout.astro";

export async function getStaticPaths() {
  return (await getCollection("blog")).filter(isVisibleEntry).map((entry) => ({
    params: { id: entry.id },
    props: entry,
  }));
}
const entry = Astro.props as CollectionEntry<"blog">;
const { Content } = await render(entry);
---

<EntryLayout entry={entry}><Content /></EntryLayout>
