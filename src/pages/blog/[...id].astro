---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { isVisibleEntry, sortByDateDesc } from "@lib/content-sort";
import EntryLayout from "@layouts/EntryLayout.astro";
import { relatedPosts } from "@lib/related-posts";

type Post = CollectionEntry<"blog">;
type Props = { entry: Post; newer?: Post; older?: Post; related: Post[] };

export async function getStaticPaths() {
  const posts = sortByDateDesc(
    (await getCollection("blog")).filter(isVisibleEntry),
  );
  return posts.map((entry, index) => {
    const newer = posts[index - 1];
    const older = posts[index + 1];
    const exclude = [newer?.id, older?.id].filter((id) => id !== undefined);
    return {
      params: { id: entry.id },
      props: {
        entry,
        newer,
        older,
        related: relatedPosts(entry, posts, { exclude }),
      },
    };
  });
}
const { entry, newer, older, related } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<EntryLayout
  entry={entry}
  newer={newer}
  older={older}
  related={related}
  headings={headings}><Content /></EntryLayout
>
