---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { isVisibleEntry, sortByDateDesc } from "@lib/content-sort";
import EntryLayout from "@layouts/EntryLayout.astro";

type Post = CollectionEntry<"blog">;
type Props = { entry: Post; newer?: Post; older?: Post };

export async function getStaticPaths() {
  const posts = sortByDateDesc(
    (await getCollection("blog")).filter(isVisibleEntry),
  );
  return posts.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, newer: posts[index - 1], older: posts[index + 1] },
  }));
}
const { entry, newer, older } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<EntryLayout entry={entry} newer={newer} older={older} headings={headings}
  ><Content /></EntryLayout
>
