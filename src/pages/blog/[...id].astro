---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import EntryBadges from "@components/EntryBadges.astro";
import OgImage from "@components/OgImage.astro";
import { SITE } from "@consts";
import { isVisibleEntry } from "@lib/content-sort";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(isVisibleEntry);
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const tags = post.data.tags ?? [];
const ogImageVersion = "20260614-og-background";
const image = post.data.ogImage ?? `/og-image/blog/${post.id}.png`;
const published = new Intl.DateTimeFormat("ja-JP", {
  dateStyle: "long",
  timeZone: "Asia/Tokyo",
}).format(post.data.date);
---

<Layout
  title={post.data.title}
  description={post.data.description ?? SITE.DESCRIPTION}
  image={post.data.ogImage ??
    `/og-image/blog/${post.id}.png?v=${ogImageVersion}`}
  page="article"
>
  <Container>
    <article class="reference-post">
      <header class="reference-post-header">
        <h1>
          <span
            data-post-transition-url={`/blog/${post.id}`}
            data-post-transition-part="title">{post.data.title}</span
          >
          <EntryBadges draft={post.data.draft} />
        </h1>
        <div class="reference-post-date">
          <time
            datetime={post.data.date.toISOString()}
            data-post-transition-url={`/blog/${post.id}`}
            data-post-transition-part="date">{published}</time
          >
        </div>
        {
          tags.length > 0 && (
            <ul class="reference-tags">
              {tags.map((tag) => (
                <li>
                  <a href={`/tags/${tag}`}>{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </header>
      <OgImage
        src={image}
        transitionUrl={`/blog/${post.id}`}
        sizes="(min-width: 640px) 672px, calc(100vw - 2rem)"
        class="reference-post-image"
        loading="eager"
        fetchpriority="high"
      />
      <div class="post-body"><Content /></div>
    </article>
  </Container>
</Layout>
