---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import EntryBadges from "@components/EntryBadges.astro";
import ShareButtons from "@components/ShareButtons.astro";
import FormattedDate from "@components/FormattedDate.astro";
import OgImage from "@components/OgImage.astro";
import PinnedIndicator from "@components/PinnedIndicator.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { SITE } from "@consts";
import { isVisibleEntry, sortByPinnedThenDateDesc } from "@lib/content-sort";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = sortByPinnedThenDateDesc(
    (await getCollection("blog")).filter(isVisibleEntry),
  );
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const ogImageVersion = "20260614-og-background";
---

<Layout
  title={post.data.title}
  description={post.data.description ?? SITE.DESCRIPTION}
  image={post.data.ogImage ??
    `/og-image/blog/${post.id}.png?v=${ogImageVersion}`}
  page="article"
>
  <Container>
    <div
      class="article-card -mx-4 w-[calc(100%+2rem)] max-w-none bg-white px-6 py-6 md:mx-auto md:w-full md:max-w-[43rem] md:px-8 dark:bg-neutral-800"
    >
      <section class="animate mx-auto mb-10">
        <h1
          class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[1.6rem] leading-[1.55] font-medium text-[#252a30] sm:text-[1.75rem] dark:text-neutral-100"
        >
          {post.data.pinned && <PinnedIndicator />}
          <span
            data-post-transition-url={`/blog/${post.id}`}
            data-post-transition-part="title">{post.data.title}</span
          >
          <EntryBadges draft={post.data.draft} />
        </h1>
        <div
          class="mt-3 flex justify-end text-base font-medium text-black dark:text-white"
        >
          <span
            data-post-transition-url={`/blog/${post.id}`}
            data-post-transition-part="date"
            ><FormattedDate date={post.data.date} /></span
          >
        </div>
      </section>
      {
        post.data.ogImage && (
          <section class="animate mx-auto mb-10">
            <OgImage
              transitionUrl={`/blog/${post.id}`}
              src={post.data.ogImage}
              sizes="(min-width: 1024px) 960px, calc(100vw - 1.5rem)"
              fallbackWidth={1200}
              class="block h-auto w-full"
            />
          </section>
        )
      }
      <div class="relative">
        {
          headings.length > 0 && (
            <aside class="mx-auto mb-10">
              <TableOfContents headings={headings} />
            </aside>
          )
        }
        <article
          class="animate mx-0 max-w-none min-w-0 sm:mx-auto sm:max-w-5xl"
        >
          <div class="post-body"><Content /></div>
          <div class="mt-12 flex flex-col gap-8">
            {
              post.data.tags && post.data.tags?.length > 0 ? (
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <a
                      href={`/tags/${tag}`}
                      class="px-2 py-1 text-sm text-black/70 no-underline hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:text-white/70 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
                    >
                      {tag}
                    </a>
                  ))}
                </div>
              ) : null
            }
            <ShareButtons title={post.data.title} url={Astro.url.href} />
          </div>
        </article>
      </div>
    </div>
  </Container>
</Layout>
