---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import { tagEmoji } from "@lib/tag-emoji";

const showDrafts = import.meta.env.DEV;
const posts = await getCollection(
  "blog",
  ({ data }) => showDrafts || !data.draft,
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <section>
      <h1 class="site-page-title">Tags</h1>
      <div class="reference-tag-grid">
        {
          tags.map((tag) => (
            <a href={`/tags/${tag}`} class="reference-tag-card">
              {tagEmoji(tag)} {tag}{" "}
              <span>
                ({posts.filter((post) => post.data.tags?.includes(tag)).length})
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </Container>
</Layout>
