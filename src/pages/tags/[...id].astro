---
import { getCollection } from "astro:content";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import { EAGER_CARD_COUNT } from "@consts";
import Layout from "@layouts/Layout.astro";
import { isVisibleEntry, sortByPinnedThenDateDesc } from "@lib/content-sort";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(isVisibleEntry);

  // Get unique tags
  const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];

  // Create paths for each tag
  return tags.map((tag) => ({
    params: { id: tag },
    props: {
      posts: posts.filter((post) => post.data.tags?.includes(tag)),
    },
  }));
}

const { id } = Astro.params;
const { posts } = Astro.props;

const sortedPosts = sortByPinnedThenDateDesc(posts);
---

<Layout title={`「${id}」の記事`} description={`タグ「${id}」の記事一覧。`}>
  <Container>
    <section data-pagefind-ignore>
      <a class="site-back-link" href="/tags/">← タグ一覧</a>
      <h1 class="site-page-title">「{id}」の記事</h1>
      <ul class="reference-post-list">
        {
          sortedPosts.map((post, index) => (
            <li>
              <ArrowCard entry={post} eager={index < EAGER_CARD_COUNT} />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
