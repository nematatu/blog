---
import { getCollection } from "astro:content";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import { isVisibleEntry, sortByPinnedThenDateDesc } from "@lib/content-sort";
import { tagEmoji } from "@lib/tag-emoji";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(isVisibleEntry);

  // Get unique tags
  const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];

  // Create paths for each tag
  return tags.map((tag) => ({
    params: { id: tag },
    props: {
      posts: posts.filter((post) => post.data.tags?.includes(tag)),
    },
  }));
}

const { id } = Astro.params;
const { posts } = Astro.props;

const sortedPosts = sortByPinnedThenDateDesc(posts);
---

<Layout title={`Tag: ${id}`} description={`Posts with the tag: ${id}`}>
  <Container>
    <section data-pagefind-ignore>
      <a class="site-back-link" href="/tags">← タグ一覧</a>
      <h1 class="site-page-title">
        {tagEmoji(id)} "{id}" の記事
      </h1>
      <ul class="reference-post-list">
        {
          sortedPosts.map((post) => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
