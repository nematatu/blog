---
import { getCollection } from "astro:content";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import { PROJECTS } from "@consts";
import { isVisibleEntry, sortByDateDesc } from "@lib/content-sort";
import Layout from "@layouts/Layout.astro";

const projects = sortByDateDesc(
  (await getCollection("projects")).filter(isVisibleEntry),
);
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <section data-pagefind-ignore>
      <h1 class="site-page-title">Projects</h1>
      <ul class="reference-post-list">
        {
          projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
