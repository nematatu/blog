---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { EAGER_CARD_COUNT, HOME } from "@consts";
import { isVisibleEntry, sortByPinnedThenDateDesc } from "@lib/content-sort";
import Layout from "@layouts/Layout.astro";

const entries = sortByPinnedThenDateDesc(
  (await getCollection("blog")).filter(isVisibleEntry),
);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} image="/ogp.png">
  <Container>
    <ul class="reference-post-list">
      {
        entries.map((entry, index) => (
          <li>
            <ArrowCard entry={entry} eager={index < EAGER_CARD_COUNT} />
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>
