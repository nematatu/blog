---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { HOME } from "@consts";
import { isVisibleEntry, sortByPinnedThenDateDesc } from "@lib/content-sort";
import Layout from "@layouts/Layout.astro";

const entries = sortByPinnedThenDateDesc(
  (await getCollection("blog")).filter(isVisibleEntry),
);
---

<Layout
  title={HOME.TITLE}
  description={HOME.DESCRIPTION}
  image="/ogp.png"
  page="home"
>
  <Container>
    <ul class="reference-post-list">
      {
        entries.map((entry) => (
          <li>
            <ArrowCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>
