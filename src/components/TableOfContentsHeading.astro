---
// https://kld.dev/building-table-of-contents/

type Heading = {
  slug: string;
  text: string;
  subheadings: Heading[];
};
const { heading } = Astro.props as { heading: Heading };
---

<li class="list-none py-1.5 text-sm">
  <a
    href={"#" + heading.slug}
    class="inline-block max-w-full break-words text-current no-underline hover:text-black focus-visible:text-black data-[active=true]:font-semibold data-[active=true]:text-[#252a30] dark:hover:text-white dark:focus-visible:text-white dark:data-[active=true]:text-white"
    data-toc-link={heading.slug}
  >
    {heading.text}
  </a>
  {
    heading.subheadings.length > 0 && (
      <ul class="ml-3 border-l border-dotted border-black/20 pl-3 dark:border-white/20">
        {heading.subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
