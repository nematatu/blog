---
import type { Heading } from "./TableOfContents.astro";

// https://kld.dev/building-table-of-contents/

const { heading } = Astro.props;
---

<li class="list-none py-1.5 text-sm">
  <a
    href={"#" + heading.slug}
    class="inline-block max-w-full break-words text-current no-underline hover:text-black focus-visible:text-black data-[active=true]:font-semibold data-[active=true]:text-blue-800 dark:hover:text-white dark:focus-visible:text-white dark:data-[active=true]:text-blue-400"
    data-toc-link={heading.slug}
  >
    {heading.text}
  </a>
  {
    heading.subheadings.length > 0 && (
      <ul class="ml-3 border-l border-black/10 pl-3 dark:border-white/10">
        {heading.subheadings.map((subheading: Heading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
