<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<div id="search"></div>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  new PagefindUI({
    element: "#search",
    bundlePath: "/pagefind/",
    showImages: false,
    excerptLength: 15,
  });
  // 検索欄には見えるラベルがないので、支援技術向けに名前を付ける。
  document
    .querySelector("#search input")
    ?.setAttribute("aria-label", "記事を検索");
</script>

<style is:global>
  #search {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--font-sans);
  }
</style>
