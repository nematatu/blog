---
interface Props {
  type?: "default" | "info" | "warning" | "error";
}
const { type = "default" } = Astro.props;
const baseClasses = "relative my-4 flex border p-3";
const typeClasses = {
  default: "border-orange-800 bg-orange-100 text-orange-950",
  info: "border-blue-800 bg-blue-100 text-blue-950",
  warning: "border-yellow-800 bg-yellow-100 text-yellow-950",
  error: "border-red-800 bg-red-100 text-red-950",
};
---

<div class:list={["not-prose", baseClasses, typeClasses[type]]}>
  <slot />
</div>
