---
import type { CollectionEntry } from "astro:content";
import EntryBadges from "@components/EntryBadges.astro";
import OgImage from "@components/OgImage.astro";
import PinnedIndicator from "@components/PinnedIndicator.astro";
import { formatDateJP } from "@lib/post-metrics";
import { cn } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"blog">;
  class?: string;
};

const { entry, class: className } = Astro.props as Props;
const dateLabel = formatDateJP(entry.data.date);
const ogImage = entry.data.ogImage;
const tags = entry.data.tags ?? [];
const primaryTag = tags[0] ?? "記事";
---

<a
  href={`/blog/${entry.id}`}
  class={cn(
    "post-card group flex h-full min-w-0 flex-col text-left no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 dark:focus-visible:outline-blue-400",
    className,
  )}
>
  <div
    class="post-card__media relative aspect-[1.91/1] w-full overflow-hidden border border-black/8 bg-white dark:border-white/10 dark:bg-neutral-800"
  >
    {
      ogImage ? (
        <OgImage
          transitionUrl={`/blog/${entry.id}`}
          src={ogImage}
          sizes="(min-width: 1024px) 19rem, (min-width: 640px) 46vw, calc(100vw - 2rem)"
          class="block h-full w-full object-cover group-hover:opacity-90"
          loading="lazy"
        />
      ) : (
        <div class="grid h-full place-items-center bg-black/[0.025] px-6 dark:bg-white/[0.025]">
          <span class="text-sm font-medium tracking-wider text-black/35 dark:text-white/35">
            #{primaryTag}
          </span>
        </div>
      )
    }
  </div>

  <div
    class="grid min-w-0 flex-1 grid-rows-[1.25rem_3.25rem_3rem_1.25rem] gap-y-2 pt-4"
  >
    <div
      class="flex min-h-5 items-center gap-2 text-xs text-black/45 dark:text-white/45"
    >
      {entry.data.pinned && <PinnedIndicator />}
      <time
        datetime={entry.data.date.toISOString()}
        data-post-transition-url={`/blog/${entry.id}`}
        data-post-transition-part="date">{dateLabel}</time
      >
    </div>

    <h3
      class="line-clamp-2 text-[1.05rem] leading-[1.55] font-semibold text-black group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-400"
    >
      <span
        data-post-transition-url={`/blog/${entry.id}`}
        data-post-transition-part="title">{entry.data.title}</span
      >
      {" "}
      <EntryBadges draft={entry.data.draft} />
    </h3>

    <p class="line-clamp-2 text-sm leading-6 text-black/55 dark:text-white/55">
      {entry.data.description ?? ""}
    </p>

    <div
      class="flex flex-wrap items-center gap-x-3 overflow-hidden text-xs text-black/40 dark:text-white/40"
    >
      {tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
    </div>
  </div>
</a>
