---
import type { CollectionEntry } from "astro:content";
import OgImage from "@components/OgImage.astro";
import { dateKey } from "@lib/post-metrics";

type Props = { entry: CollectionEntry<"blog"> | CollectionEntry<"projects"> };
const { entry } = Astro.props;
const url = `/${entry.collection}/${entry.id}/`;
const tags = entry.collection === "blog" ? (entry.data.tags ?? []) : [];
---

<a
  class:list={["reference-post-card", entry.data.ogImage && "has-image"]}
  href={url}
  data-astro-prefetch="viewport"
  data-post-transition-url={url}
>
  {
    entry.data.ogImage && (
      <OgImage
        src={entry.data.ogImage}
        sizes="(min-width: 640px) 9rem, 6rem"
        class="reference-post-card-image"
        loading="lazy"
      />
    )
  }
  <div class="post-card-content">
    <h2>
      <span class="post-transition-title">{entry.data.title}</span>
      {
        entry.collection === "blog" && entry.data.pinned && (
          <span aria-label="固定記事" title="固定記事">
            📌
          </span>
        )
      }
      {entry.data.draft && <span class="draft-label">(draft)</span>}
    </h2>
    <div class="post-card-meta">
      {
        tags.length > 0 && (
          <ul class="reference-tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <time datetime={entry.data.date.toISOString()}
        >{dateKey(entry.data.date).replaceAll("-", "/")}</time
      >
    </div>
  </div>
</a>
