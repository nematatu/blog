---
import type { CollectionEntry } from "astro:content";
import EntryBadges from "@components/EntryBadges.astro";
import OgImage from "@components/OgImage.astro";
import PinnedIndicator from "@components/PinnedIndicator.astro";
import { dateKey } from "@lib/post-metrics";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};
const { entry } = Astro.props;
const url = `/${entry.collection}/${entry.id}`;
const image = entry.data.ogImage;
const tags = entry.collection === "blog" ? (entry.data.tags ?? []) : [];
---

<a
  class:list={["reference-post-card", image && "has-image"]}
  href={url}
  data-post-transition-url={url}
>
  {
    image && (
      <OgImage
        src={image}
        sizes="(min-width: 640px) 9rem, 6rem"
        class="reference-post-card-image"
        loading="lazy"
      />
    )
  }
  <article>
    <h2>
      <span class="post-transition-title">{entry.data.title}</span>
      {entry.collection === "blog" && entry.data.pinned && <PinnedIndicator />}
      <EntryBadges draft={entry.data.draft} />
    </h2>
    <time datetime={entry.data.date.toISOString()}
      >{dateKey(entry.data.date).replaceAll("-", "/")}</time
    >
    {
      tags.length > 0 && (
        <ul class="reference-tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</a>
