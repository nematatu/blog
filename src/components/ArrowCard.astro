---
import type { CollectionEntry } from "astro:content";
import EntryBadges from "@components/EntryBadges.astro";
import OgImage from "@components/OgImage.astro";
import PinnedIndicator from "@components/PinnedIndicator.astro";
import { dateKey } from "@lib/post-metrics";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  loading?: "eager" | "lazy";
};
const { entry, loading = "lazy" } = Astro.props;
const url = `/${entry.collection}/${entry.id}`;
const image =
  entry.data.ogImage ?? `/og-image/${entry.collection}/${entry.id}.png`;
const tags = entry.collection === "blog" ? (entry.data.tags ?? []) : [];
---

<a class="reference-post-card" href={url}>
  <OgImage
    src={image}
    transitionUrl={entry.collection === "blog" ? url : undefined}
    sizes="(min-width: 640px) 9rem, 6rem"
    class="reference-post-card-image"
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : "auto"}
  />
  <article>
    <h2>
      <span
        data-post-transition-url={entry.collection === "blog" ? url : undefined}
        data-post-transition-part={entry.collection === "blog"
          ? "title"
          : undefined}>{entry.data.title}</span
      >
      {entry.collection === "blog" && entry.data.pinned && <PinnedIndicator />}
      <EntryBadges draft={entry.data.draft} />
    </h2>
    <time
      datetime={entry.data.date.toISOString()}
      data-post-transition-url={entry.collection === "blog" ? url : undefined}
      data-post-transition-part={entry.collection === "blog"
        ? "date"
        : undefined}>{dateKey(entry.data.date).replaceAll("-", "/")}</time
    >
    {
      tags.length > 0 && (
        <ul class="reference-tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</a>
