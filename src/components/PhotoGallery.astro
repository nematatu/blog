---
import type { GalleryPhoto } from "@/data/gallery";

type Props = { photos: GalleryPhoto[] };
const { photos } = Astro.props;
---

<section
  class="photo-gallery mx-auto w-full max-w-[124rem]"
  data-photo-gallery
  aria-label="画像ギャラリー"
>
  {photos.length === 0 && <p>公開されている画像はまだありません。</p>}
  <div
    class="photo-gallery__grid grid grid-cols-2 gap-4 max-sm:gap-2 lg:grid-cols-3 2xl:grid-cols-4"
  >
    {
      photos.map((photo, index) => (
        <a
          class="photo-gallery__tile relative block min-w-0 self-start overflow-hidden text-white no-underline"
          href={`/gallery/?photo=${encodeURIComponent(photo.id)}`}
          data-gallery-open
          data-gallery-id={photo.id}
          data-gallery-article-href={photo.articleHref}
          aria-label={`${photo.title}を拡大表示`}
          aria-haspopup="dialog"
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={index === 0 ? "high" : "auto"}
            draggable="false"
            data-no-lightbox
          />
          <span
            class="photo-gallery__tile-error absolute inset-x-3 top-[20%] text-center text-[0.8125rem]"
            hidden
            data-gallery-tile-error
          >
            画像を読み込めませんでした
          </span>
        </a>
      ))
    }
  </div>

  <dialog
    class="photo-gallery__dialog fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-hidden border-0 p-0 text-white"
    data-gallery-dialog
    aria-label="写真ビューア"
  >
    <div
      class="photo-gallery__viewer relative grid h-full w-full grid-rows-[auto_minmax(0,1fr)_auto] gap-3"
    >
      <div class="photo-gallery__topbar">
        <button
          class="photo-gallery__control"
          type="button"
          data-gallery-close
          aria-label="ギャラリーを閉じる"
          autofocus
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m6 6 12 12M6 18 18 6"></path></svg
          >
        </button>
        <div class="photo-gallery__current">
          <a
            class="mt-1 block overflow-hidden text-xs text-ellipsis whitespace-nowrap text-[#ddd] underline underline-offset-[3px]"
            data-gallery-article
            href="/">記事を開く</a
          >
        </div>
      </div>
      <div class="photo-gallery__stage min-h-0 min-w-0">
        <button
          class="photo-gallery__arrow"
          type="button"
          data-gallery-previous
          aria-label="前の写真"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m15 18-6-6 6-6"></path></svg
          >
        </button>
        <div
          class="photo-gallery__image-frame relative grid h-full min-h-0 w-full min-w-0 place-items-center"
          data-gallery-image-frame
        >
          <img
            class="photo-gallery__image block h-full min-h-0 w-full object-contain select-none"
            alt=""
            draggable="false"
            data-gallery-image
            data-no-lightbox
            hidden
          />
          <div
            class="photo-gallery__feedback pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-4 p-4 text-center text-sm"
            data-gallery-feedback
          >
            <p data-gallery-message role="status"></p>
            <button type="button" data-gallery-retry hidden>再読み込み</button>
          </div>
        </div>
        <button
          class="photo-gallery__arrow"
          type="button"
          data-gallery-next
          aria-label="次の写真"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m9 18 6-6-6-6"></path></svg
          >
        </button>
      </div>
      <div class="min-w-0">
        <div
          class="photo-gallery__status mb-2 min-h-5 text-center text-xs text-[#ccc]"
          aria-live="polite"
          aria-atomic="true"
        >
          <span data-gallery-position></span>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import "@/scripts/gallery";
</script>

<style>
  .photo-gallery__tile {
    aspect-ratio: 3 / 2;
    background: #252525;
  }

  .photo-gallery__tile img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo-gallery__tile img {
    object-fit: contain;
  }

  .photo-gallery__tile:focus-visible {
    outline: 3px solid #60a5fa;
    outline-offset: 3px;
  }
  .photo-gallery__dialog,
  .photo-gallery__dialog::backdrop {
    background: #080808;
  }
  .photo-gallery__viewer {
    padding: max(0.75rem, env(safe-area-inset-top))
      max(0.75rem, env(safe-area-inset-right))
      max(0.75rem, env(safe-area-inset-bottom))
      max(0.75rem, env(safe-area-inset-left));
  }

  .photo-gallery__topbar,
  .photo-gallery__stage {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.75rem;
  }

  .photo-gallery__current {
    min-width: 0;
    text-align: center;
  }
  .photo-gallery__control,
  .photo-gallery__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    padding: 0;
    color: white;
    background: rgb(0 0 0 / 45%);
    cursor: pointer;
    touch-action: manipulation;
  }

  .photo-gallery__control svg,
  .photo-gallery__arrow svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .photo-gallery__control:hover,
  .photo-gallery__arrow:hover:not(:disabled) {
    background: #383838;
  }
  .photo-gallery__arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .photo-gallery__dialog :is(button, a):focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .photo-gallery__image-frame {
    touch-action: pan-y pinch-zoom;
  }

  .photo-gallery__feedback button {
    padding: 0.6rem 1rem;
    background: #222;
    cursor: pointer;
    pointer-events: auto;
  }
  .photo-gallery [hidden] {
    display: none;
  }

  @media (max-width: 639px) {
    .photo-gallery__stage {
      grid-template-columns: 1fr auto auto;
      grid-template-rows: minmax(0, 1fr) 2.75rem;
      gap: 0.5rem;
    }
    .photo-gallery__image-frame {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .photo-gallery__arrow {
      grid-row: 2;
    }
    [data-gallery-previous] {
      grid-column: 2;
    }
    [data-gallery-next] {
      grid-column: 3;
    }
    .photo-gallery__current {
      text-align: left;
    }
  }
  @media (max-height: 480px) and (min-width: 640px) {
    .photo-gallery__viewer {
      gap: 0.25rem;
      padding-block: 0.5rem;
    }
    .photo-gallery__status {
      margin-bottom: 0;
    }
  }
  :global(html.photo-gallery-open) {
    overflow: hidden;
  }
</style>
