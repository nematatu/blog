---
import type { GalleryPhoto } from "@/data/gallery";

type Props = { photos: GalleryPhoto[] };
const { photos } = Astro.props;
const serializedPhotos = JSON.stringify(photos).replaceAll("<", "\\u003c");
---

<section class="photo-gallery" data-photo-gallery aria-label="画像ギャラリー">
  <h1 class="sr-only">Gallery</h1>
  {photos.length === 0 && <p>公開されている画像はまだありません。</p>}
  <div class="photo-gallery__grid">
    {
      photos.map((photo, index) => (
        <a
          class="photo-gallery__tile"
          href={`/gallery/?photo=${encodeURIComponent(photo.id)}`}
          data-gallery-open
          data-gallery-index={index}
          style={
            photo.width && photo.height
              ? `--photo-ratio: ${photo.width} / ${photo.height}`
              : undefined
          }
          data-astro-prefetch="false"
          aria-label={`${photo.title}を拡大表示`}
          aria-haspopup="dialog"
        >
          <img
            src={photo.src}
            width={photo.width}
            height={photo.height}
            alt={photo.alt}
            loading={index < 6 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={index === 0 ? "high" : "auto"}
            draggable="false"
            data-no-lightbox
          />
          <span
            class="photo-gallery__tile-error"
            hidden
            data-gallery-tile-error
          >
            画像を読み込めませんでした
          </span>
        </a>
      ))
    }
  </div>

  <dialog
    class="photo-gallery__dialog"
    data-gallery-dialog
    aria-label="写真ビューア"
  >
    <div
      class="photo-gallery__backdrop"
      data-gallery-backdrop
      aria-hidden="true"
    >
    </div>
    <div class="photo-gallery__viewer">
      <div class="photo-gallery__topbar">
        <button
          class="photo-gallery__control"
          type="button"
          data-gallery-close
          aria-label="ギャラリーを閉じる"
          autofocus
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m6 6 12 12M6 18 18 6"></path></svg
          >
        </button>
        <div class="photo-gallery__current">
          <a data-gallery-article href="/blog">記事を開く</a>
        </div>
      </div>
      <div class="photo-gallery__stage" data-gallery-stage>
        <button
          class="photo-gallery__arrow"
          type="button"
          data-gallery-previous
          aria-label="前の写真"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m15 18-6-6 6-6"></path></svg
          >
        </button>
        <div class="photo-gallery__image-frame" data-gallery-image-frame>
          <img
            class="photo-gallery__image"
            alt=""
            draggable="false"
            data-gallery-image
            data-no-lightbox
            hidden
          />
          <div class="photo-gallery__feedback" data-gallery-feedback>
            <p data-gallery-message role="status"></p>
            <button type="button" data-gallery-retry hidden>再読み込み</button>
          </div>
        </div>
        <button
          class="photo-gallery__arrow"
          type="button"
          data-gallery-next
          aria-label="次の写真"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m9 18 6-6-6-6"></path></svg
          >
        </button>
      </div>
      <div class="photo-gallery__bottom">
        <div
          class="photo-gallery__status"
          aria-live="polite"
          aria-atomic="true"
        >
          <span data-gallery-position></span>
        </div>
        <div
          class="photo-gallery__thumbnails"
          data-gallery-thumbnails
          aria-label="写真一覧"
        >
          {
            photos.map((photo, index) => (
              <button
                class="photo-gallery__thumbnail"
                type="button"
                data-gallery-thumbnail
                data-gallery-index={index}
                aria-label={`${index + 1}: ${photo.title}を表示`}
              >
                <img
                  data-src={photo.src}
                  alt=""
                  decoding="async"
                  draggable="false"
                  data-no-lightbox
                />
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </dialog>
  <script
    is:inline
    type="application/json"
    data-gallery-data
    set:html={serializedPhotos}
  />
</section>

<script>
  import "@/scripts/gallery";
</script>

<style>
  .photo-gallery {
    width: 100%;
    max-width: 124rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 2vw, 2rem);
  }
  .photo-gallery__heading p {
    font-size: 0.8125rem;
    opacity: 0.65;
  }

  .photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .photo-gallery__grid[data-masonry] {
    grid-auto-rows: 1px;
    row-gap: 0;
  }

  .photo-gallery__tile {
    position: relative;
    display: block;
    min-width: 0;
    aspect-ratio: var(--photo-ratio, 3 / 2);
    align-self: start;
    overflow: hidden;
    color: white;
    background: #252525;
    text-decoration: none;
  }

  .photo-gallery__tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .photo-gallery__tile:focus-visible {
    outline: 3px solid #60a5fa;
    outline-offset: 3px;
  }
  .photo-gallery__tile-error {
    position: absolute;
    inset: 20% 0.75rem auto;
    text-align: center;
    font-size: 0.8125rem;
  }

  .photo-gallery__dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    color: white;
    background: #080808;
  }

  .photo-gallery__dialog::backdrop {
    background: #080808;
  }
  .photo-gallery__backdrop {
    position: absolute;
    inset: -3rem;
    background-position: center;
    background-size: cover;
    filter: blur(40px) brightness(0.2);
    opacity: 0.6;
    pointer-events: none;
  }

  .photo-gallery__viewer {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: 100%;
    height: 100%;
    padding: max(0.75rem, env(safe-area-inset-top))
      max(0.75rem, env(safe-area-inset-right))
      max(0.75rem, env(safe-area-inset-bottom))
      max(0.75rem, env(safe-area-inset-left));
    gap: 0.75rem;
  }

  .photo-gallery__topbar {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.75rem;
  }

  .photo-gallery__current {
    min-width: 0;
    text-align: center;
  }
  .photo-gallery__current a {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .photo-gallery__current time {
    display: block;
    font-size: 0.6875rem;
    color: #bdbdbd;
    margin-top: 0.2rem;
  }
  .photo-gallery__current a {
    font-size: 0.75rem;
    margin-top: 0.25rem;
    color: #ddd;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .photo-gallery__control,
  .photo-gallery__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    padding: 0;
    color: white;
    background: rgb(0 0 0 / 45%);
    cursor: pointer;
    touch-action: manipulation;
  }

  .photo-gallery__control svg,
  .photo-gallery__arrow svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .photo-gallery__control:hover,
  .photo-gallery__arrow:hover:not(:disabled) {
    background: #383838;
  }
  .photo-gallery__arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .photo-gallery__dialog :is(button, a):focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .photo-gallery__stage {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    min-height: 0;
    min-width: 0;
    gap: 0.75rem;
  }

  .photo-gallery__image-frame {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    min-width: 0;
    touch-action: pan-y pinch-zoom;
  }

  .photo-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    user-select: none;
  }

  .photo-gallery__feedback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem;
    text-align: center;
    font-size: 0.875rem;
    pointer-events: none;
  }

  .photo-gallery__feedback button {
    padding: 0.6rem 1rem;
    background: #222;
    cursor: pointer;
    pointer-events: auto;
  }
  .photo-gallery__bottom {
    min-width: 0;
  }
  .photo-gallery__status {
    min-height: 1.25rem;
    margin-bottom: 0.5rem;
    text-align: center;
    color: #ccc;
    font-size: 0.75rem;
  }
  .photo-gallery__thumbnails {
    display: flex;
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    gap: 0.5rem;
    padding: 0.3rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .photo-gallery__thumbnail {
    flex: 0 0 4.5rem;
    width: 4.5rem;
    height: 3rem;
    padding: 0;
    overflow: hidden;
    background: #333;
    opacity: 0.5;
    cursor: pointer;
  }
  .photo-gallery__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-gallery__thumbnail[aria-current="true"] {
    opacity: 1;
  }
  .photo-gallery [hidden] {
    display: none;
  }

  @media (min-width: 1024px) {
    .photo-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1536px) {
    .photo-gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .photo-gallery__grid {
      gap: 0.5rem;
    }

    .photo-gallery__grid[data-masonry] {
      row-gap: 0;
    }
    .photo-gallery__stage {
      grid-template-columns: 1fr auto auto;
      grid-template-rows: minmax(0, 1fr) 2.75rem;
      gap: 0.5rem;
    }
    .photo-gallery__image-frame {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .photo-gallery__arrow {
      grid-row: 2;
    }
    [data-gallery-previous] {
      grid-column: 2;
    }
    [data-gallery-next] {
      grid-column: 3;
    }
    .photo-gallery__current {
      text-align: left;
    }
  }
  @media (max-height: 480px) and (min-width: 640px) {
    .photo-gallery__viewer {
      gap: 0.25rem;
      padding-block: 0.5rem;
    }
    .photo-gallery__thumbnail {
      flex-basis: 3.25rem;
      width: 3.25rem;
      height: 2.25rem;
    }
    .photo-gallery__status {
      margin-bottom: 0;
    }
  }
  :global(html.photo-gallery-open) {
    overflow: hidden;
  }

  :global(html:has([data-photo-gallery])) {
    scrollbar-gutter: stable;
  }
</style>
