---
import type { GalleryPhoto } from "@/data/gallery";
type Props = { photos: GalleryPhoto[] };
const { photos } = Astro.props;
---

<section class="photo-gallery" data-photo-gallery aria-label="画像ギャラリー">
  {photos.length === 0 && <p>公開されている画像はまだありません。</p>}
  <div class="photo-grid">
    {
      photos.map((photo, index) => (
        <a
          href={`/gallery/?photo=${encodeURIComponent(photo.id)}`}
          data-gallery-open
          data-gallery-id={photo.id}
          data-gallery-article-href={photo.articleHref}
          aria-label={`${photo.title}を拡大表示`}
          aria-haspopup="dialog"
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </a>
      ))
    }
  </div>
  <dialog class="image-viewer" data-gallery-dialog aria-label="写真ビューア">
    <form method="dialog">
      <a data-gallery-article href="/">記事を開く</a>
      <button aria-label="ギャラリーを閉じる" autofocus>×</button>
    </form>
    <img data-gallery-image alt="" draggable="false" />
    <div class="gallery-controls">
      <p data-gallery-message role="status"></p>
      <button type="button" data-gallery-retry hidden>再読み込み</button>
      <nav aria-label="写真の切り替え">
        <button type="button" data-gallery-previous aria-label="前の写真"
          >←</button
        >
        <span data-gallery-position aria-live="polite" aria-atomic="true"
        ></span>
        <button type="button" data-gallery-next aria-label="次の写真">→</button>
      </nav>
    </div>
  </dialog>
</section>

<script>
  import "@/scripts/gallery";
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .photo-grid a {
    aspect-ratio: 3 / 2;
    background: #252525;
  }
  .photo-grid img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery-controls {
    grid-row: 3;
    text-align: center;
  }
  .gallery-controls nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  [data-gallery-image] {
    touch-action: pan-y pinch-zoom;
  }
  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
</style>
