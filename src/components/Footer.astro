---
import Container from "@components/Container.astro";
import { SITE, SOCIALS, PAGES } from "@consts";
---

<footer class="reference-site-footer">
  <Container>
    <nav aria-label="フッターリンク">
      {Astro.url.pathname !== "/" && <a href="/">記事一覧</a>}
      {PAGES.map((page) => <a href={`/${page}`}>{page}</a>)}
      {
        SOCIALS.map((social) => (
          <a
            href={social.HREF}
            target={social.EXTERNAL ? "_blank" : undefined}
            rel={social.EXTERNAL ? "noopener noreferrer" : undefined}
          >
            {social.NAME}
          </a>
        ))
      }
    </nav>
    <small>© {new Date().getFullYear()} {SITE.TITLE}</small>
  </Container>
</footer>
