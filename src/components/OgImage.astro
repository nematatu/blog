---
import { getOgThumbnailSet } from "@lib/thumbnails";
import { getOgImageDimensions } from "@lib/og-image-dimensions";

type Props = {
  src: string;
  alt?: string;
  class?: string;
  sizes: string;
  fallbackWidth?: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  ariaHidden?: boolean;
  transitionUrl?: string;
};

const {
  src,
  alt = "",
  class: className,
  sizes,
  fallbackWidth,
  loading,
  fetchpriority,
  ariaHidden = alt.length === 0,
  transitionUrl,
} = Astro.props as Props;

const thumbnail =
  import.meta.env.DEV && src.startsWith("/og-image/")
    ? undefined
    : getOgThumbnailSet(src, fallbackWidth);
const dimensions = await getOgImageDimensions(src);
const generated = src.startsWith("/og-image/");
---

<img
  data-post-transition-url={transitionUrl}
  data-post-transition-part={transitionUrl ? "image" : undefined}
  src={thumbnail?.src ?? src}
  srcset={thumbnail?.srcset}
  sizes={thumbnail ? sizes : undefined}
  width={dimensions?.width ?? (generated ? 1200 : undefined)}
  height={dimensions?.height ?? (generated ? 630 : undefined)}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  aria-hidden={ariaHidden ? "true" : undefined}
/>
