---
import path from "node:path";
import sharp from "sharp";

type Props = {
  src: string;
  alt?: string;
  class?: string;
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
};
const {
  src,
  alt = "",
  class: className,
  sizes,
  loading,
  fetchpriority,
} = Astro.props;
const name = src.match(/^\/ogp\/([^/]+)\.(?:avif|jpe?g|png|webp)$/i)?.[1];
const dimensions = name
  ? await sharp(path.resolve("public", src.slice(1))).metadata()
  : undefined;
const thumbnail = (width: number) => `/thumbs/ogp/${name}-${width}.webp`;
---

<img
  src={name ? thumbnail(480) : src}
  srcset={name
    ? [240, 480, 960, 1200]
        .map((width) => `${thumbnail(width)} ${width}w`)
        .join(", ")
    : undefined}
  sizes={name ? sizes : undefined}
  width={dimensions?.width}
  height={dimensions?.height}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  aria-hidden={alt ? undefined : "true"}
/>
