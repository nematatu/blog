---
import TableOfContentsHeading from "./TableOfContentsHeading.astro";

// https://kld.dev/building-table-of-contents/
const { headings = [] } = Astro.props as { headings?: Heading[] };
const toc = buildToc(headings);

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

type TocHeading = Heading & { subheadings: TocHeading[] };

function buildToc(headings: Heading[] = []) {
  const toc: TocHeading[] = [];
  const parents: TocHeading[] = [];
  for (const item of headings) {
    const heading: TocHeading = { ...item, subheadings: [] };
    while (parents.length && parents.at(-1)!.depth >= heading.depth)
      parents.pop();
    (parents.at(-1)?.subheadings ?? toc).push(heading);
    parents.push(heading);
  }
  return toc;
}
---

<details
  open={headings.length <= 12}
  class="group border-y border-[#ebeef2] px-1 py-4 dark:border-white/15"
>
  <summary
    class="cursor-pointer text-sm font-medium text-[#252a30] hover:text-black dark:text-neutral-200 dark:hover:text-white"
    >目次</summary
  >
  <nav class="mt-3 pr-0">
    <ul class="py-0">
      {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
    </ul>
  </nav>
</details>

<script is:inline>
  (() => {
    const setActiveTocLink = () => {
      const headings = Array.from(
        document.querySelectorAll("article :is(h2, h3, h4, h5, h6)[id]"),
      );
      const links = Array.from(document.querySelectorAll("[data-toc-link]"));
      if (headings.length === 0 || links.length === 0) return;

      const scrollPosition = window.scrollY + 140;
      let active = headings[0];
      for (const heading of headings) {
        const headingTop = heading.getBoundingClientRect().top + window.scrollY;
        if (headingTop <= scrollPosition) {
          active = heading;
        } else {
          break;
        }
      }

      for (const link of links) {
        const isActive = link.dataset.tocLink === active.id;
        link.dataset.active = String(isActive);
        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    let activeLinkFrame = 0;
    const queueActiveTocLinkUpdate = () => {
      if (activeLinkFrame) return;
      activeLinkFrame = window.requestAnimationFrame(() => {
        activeLinkFrame = 0;
        setActiveTocLink();
      });
    };

    setActiveTocLink();
    window.addEventListener("scroll", queueActiveTocLinkUpdate, {
      passive: true,
    });
    window.addEventListener("resize", queueActiveTocLinkUpdate, {
      passive: true,
    });
  })();
</script>
