---
import Container from "@components/Container.astro";
import { SITE } from "@consts";

const pages = ["gallery", "stats", "projects", "tags"];
---

<header class="reference-site-header">
  <Container>
    <a href="/">{SITE.TITLE}</a>
    <nav aria-label="サイト内リンク">
      {pages.map((page) => <a href={`/${page}`}>{page}</a>)}
      <a href="/search">search</a>
    </nav>
  </Container>
</header>
